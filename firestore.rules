rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.keys().size() == 5
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() < 256
        && data.displayName is string && data.displayName.size() < 128
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() < 1024))
        && data.createdAt == request.time;
    }

    function isValidStory(data) {
      return data.keys().hasAll(['userId', 'genre', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.userId == request.auth.uid
        && data.genre in ['romance', 'crime', 'paranormal']
        && data.status in ['active', 'completed']
        && (request.method == 'create' ? data.createdAt == request.time : data.createdAt == existing().createdAt)
        && data.updatedAt == request.time;
    }

    function isValidStep(data) {
      return data.keys().hasAll(['sceneTitle', 'sceneDescription', 'imageUrl', 'choiceTaken', 'timestamp', 'imagePrompt', 'choices'])
        && data.keys().size() == 7
        && data.sceneTitle is string && data.sceneTitle.size() < 256
        && data.sceneDescription is string && data.sceneDescription.size() < 50000
        && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() < 2048))
        && (data.choiceTaken == null || (data.choiceTaken is string && data.choiceTaken.size() < 1024))
        && (data.imagePrompt == null || (data.imagePrompt is string && data.imagePrompt.size() < 5000))
        && (data.choices == null || (data.choices is list && data.choices.size() <= 10))
        && data.timestamp == request.time;
    }

    // --- Routes ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt;

      match /stories/{storyId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(storyId) && isValidStory(incoming());
        allow update: if isOwner(userId) 
          && isValidStory(incoming())
          && (
            // Action: Update Status or Narrative Progress
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          );
        allow delete: if isOwner(userId);

        match /steps/{stepId} {
          allow list, get: if isOwner(userId);
          allow create: if isOwner(userId) && isValidId(stepId) && isValidStep(incoming());
        }
      }
    }
  }
}
