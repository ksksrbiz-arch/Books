# ============================================================
# Echoes of Choice Adventure — environment variables
# Copy this file to `.env.local` (for local dev) or use your
# platform's secret manager in production.
# ============================================================

# ---------- Required ----------

# GEMINI_API_KEY: API key for the Google Generative Language API ("Gemini").
# You can obtain a key from either:
#   - Google AI Studio: https://aistudio.google.com/apikey
#   - A Google Cloud project with the Generative Language API enabled
#     (https://console.cloud.google.com/apis/library/generativelanguage.googleapis.com)
# The app does NOT require AI Studio at runtime — only the key.
GEMINI_API_KEY=""

# APP_URL: Public URL where this application is hosted (e.g., https://echoes.example.com).
# Used for self-referential links, Stripe redirect URLs, and OAuth callbacks.
APP_URL="http://localhost:3000"

# NODE_ENV: "development" or "production". In production, Vite middleware is disabled
# and the prebuilt assets in `dist/` are served instead.
NODE_ENV="development"

# PORT: HTTP port the Express server listens on. Default 3000.
PORT="3000"

# ---------- Firebase (server / Admin SDK) ----------

# GOOGLE_APPLICATION_CREDENTIALS: Path to a Google service-account JSON key file
# with `roles/datastore.user` + `roles/storage.objectAdmin` on your Firebase project.
# On Cloud Run / GKE / Cloud Functions, omit this and rely on workload identity instead.
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional explicit overrides for Firebase Admin if you don't have a config file
# checked in (or want to override `firebase-applet-config.json` at runtime):
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""

# ---------- Firebase (web client, injected at build time) ----------
# These are read by Vite and embedded into the SPA bundle.
# They are NOT secrets (the Firebase web API key is a public identifier),
# but you should restrict the key by HTTP referrer and API in the Cloud Console
# and pair it with Firebase App Check (see VITE_FIREBASE_APP_CHECK_SITE_KEY below).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Optional: enable Firebase App Check using reCAPTCHA v3 site key.
# Leave blank to disable. Highly recommended in production.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# ---------- Stripe (payments) ----------

# STRIPE_SECRET_KEY: Required to enable Stripe Checkout. Without it the
# /api/create-checkout-session endpoint will return a 500.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Required to verify Stripe webhook signatures at
# /api/stripe-webhook. Get this from your Stripe dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=""

# ---------- Premium TTS (optional) ----------

# ELEVENLABS_API_KEY: Enables premium human-sounding voice synthesis.
ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID: Optional custom voice ID. Defaults to "Rachel" if blank.
ELEVENLABS_VOICE_ID=""

# OPENAI_API_KEY: Enables OpenAI TTS voices AND serves as a cross-vendor
# fallback for text generation when the Gemini API is unavailable. Optional
# but recommended for true "high uptime" — see docs/RUNBOOK.md.
OPENAI_API_KEY=""

# ---------- High availability / scale-out (optional) ----------

# REDIS_URL: When set, the response cache, async-job queue and rate-limiter
# counters are stored in Redis instead of process memory. Required if you run
# more than one instance of the server behind a load balancer. Example:
#   redis://redis.example.com:6379
REDIS_URL=""

# LOG_LEVEL: "trace" | "debug" | "info" | "warn" | "error". Default "info".
LOG_LEVEL="info"

# LOG_FORMAT: "json" (structured pino output for Cloud Logging / Datadog) or
# "pretty" (human-readable for local dev). Default "pretty" outside production.
LOG_FORMAT=""
